/*
 * Disposition du clavier. Les codes sont ceux d'un clavier standard :
 * avec l'ordinateur réglé en « Français (AZERTY) », chaque touche donne
 * ce qui est imprimé dessus (ex. la touche A envoie le code Q).
 *
 * Preset 1 à 4 -> profils Bluetooth 1 à 4 (un appareil par profil)
 * Touche Veille (lune) maintenue = couche « Fonctions » :
 *   Veille + Echap          -> efface l'appairage du profil Bluetooth actif
 *   Veille + Retour arrière -> mode flash (mise à jour sans ouvrir le clavier)
 *   Veille + Suppr          -> redémarre le clavier
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
                /* Touches spéciales (en haut) */
                &mo 1  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &kp C_MUTE
                &kp C_VOL_DN  &kp C_VOL_UP  &kp C_PP  &kp C_STOP  &kp C_PREV  &kp C_NEXT
                /* Rangée des fonctions */
                &kp ESC  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
                &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
                &kp F12
                /* Rangée des chiffres */
                &kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5
                &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp MINUS
                &kp EQUAL  &kp BSPC
                /* Rangée a z e r t y */
                &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T
                &kp Y  &kp U  &kp I  &kp O  &kp P  &kp LBKT
                &kp RBKT  &kp RET
                /* Rangée q s d f g */
                &kp CAPS  &kp A  &kp S  &kp D  &kp F  &kp G
                &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp SQT
                &kp NON_US_HASH
                /* Rangée w x c v b */
                &kp LSHFT  &kp NON_US_BSLH  &kp Z  &kp X  &kp C  &kp V
                &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH
                &kp RSHFT
                /* Rangée du bas */
                &kp LCTRL  &kp LGUI  &kp LALT  &kp SPACE  &kp RALT  &kp RGUI
                &kp K_APP  &kp RCTRL
                /* Bloc de navigation */
                &kp HOME  &kp END  &kp INS  &kp PG_UP  &kp DEL  &kp PG_DN
                &kp PSCRN  &kp SLCK  &kp PAUSE_BREAK  &kp C_AL_CALC
                /* Flèches */
                &kp UP  &kp LEFT  &kp DOWN  &kp RIGHT
                /* Pavé numérique */
                &kp KP_NUMLOCK  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp KP_MINUS  &kp KP_N7  &kp KP_N8
                &kp KP_N9  &kp KP_PLUS  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_N1
                &kp KP_N2  &kp KP_N3  &kp KP_ENTER  &kp KP_N0  &kp KP_DOT
            >;
        };

        fonctions {
            display-name = "Fn";
            bindings = <
                /* Touches spéciales (en haut) */
                &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans
                /* Rangée des fonctions */
                &bt BT_CLR  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans
                &trans
                /* Rangée des chiffres */
                &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &bootloader
                /* Rangée a z e r t y */
                &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans
                /* Rangée q s d f g */
                &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans
                &trans
                /* Rangée w x c v b */
                &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans
                &trans
                /* Rangée du bas */
                &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans
                /* Bloc de navigation */
                &trans  &trans  &trans  &trans  &sys_reset  &trans
                &trans  &trans  &trans  &trans
                /* Flèches */
                &trans  &trans  &trans  &trans
                /* Pavé numérique */
                &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
